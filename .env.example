# Base URL of the Express API. Leave empty in dev (Vite proxies /api and /uploads to localhost:5000).
VITE_API_URL=
# Origin used to build absolute URLs for uploaded images in production builds.
VITE_API_ORIGIN=
# Optional: Google OAuth client ID for real "Sign in with Google". Without it a dev mock prompt is used.
VITE_GOOGLE_CLIENT_ID=

# SEO. Everything here is public information, these are compiled into the browser bundle.
# Canonical production origin. Used for every canonical URL, og:url and sitemap <loc>, and
# for the initial HTML the build step generates. Defaults to https://call2now.com.
VITE_SITE_URL=https://call2now.com
# Optional GA4 stream ID (G-XXXXXXX). With no value set, no analytics script is requested
# and no tracking request leaves the browser. Never put a backend secret in this file.
VITE_GA_MEASUREMENT_ID=
