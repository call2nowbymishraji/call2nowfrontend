# Base URL of the Express API. Leave empty in dev (Vite proxies /api and /uploads to localhost:5000).
VITE_API_URL=
# Origin used to build absolute URLs for uploaded images in production builds.
VITE_API_ORIGIN=
# Optional: Google OAuth client ID for real "Sign in with Google". Without it a dev mock prompt is used.
VITE_GOOGLE_CLIENT_ID=1076810103836-0r02m5i9qqu6vn5g15tcp8vis3df39te.apps.googleusercontent.com
